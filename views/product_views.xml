<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_rental" model="ir.ui.view">
        <field name="name">product.template.form.rental</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Renta" name="rental">
                    <group>
                        <group string="Configuración de renta" name="rental_config">
                            <field name="rental_ok"/>
                            <field name="rental_price" invisible="not rental_ok"/>
                        </group>
                        <group string="Contabilidad de renta" name="rental_accounting"
                               groups="account.group_account_readonly">
                            <field name="rental_income_account_id" invisible="not rental_ok"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
