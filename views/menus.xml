<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_rental_quotations" model="ir.actions.act_window">
        <field name="name">Cotizaciones de renta</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_rental', '=', True)]</field>
        <field name="context">{'default_is_rental': True}</field>
    </record>

    <record id="action_rental_active_lines" model="ir.actions.act_window">
        <field name="name">Artículos en renta</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_rental_active_line_search"/>
        <field name="domain">[('order_id.is_rental', '=', True), ('order_id.state', '=', 'sale'), ('order_id.rental_status', '=', 'active'), ('display_type', '=', False)]</field>
    </record>

    <record id="action_rental_products" model="ir.actions.act_window">
        <field name="name">Productos rentables</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('rental_ok', '=', True)]</field>
        <field name="context">{'default_rental_ok': True}</field>
    </record>

    <menuitem id="menu_rental_root" name="Rentas" sequence="15"
              groups="group_rental_user"/>

    <menuitem id="menu_rental_quotations" name="Cotizaciones de renta"
              parent="menu_rental_root" action="action_rental_quotations"
              sequence="10"/>

    <menuitem id="menu_rental_active_lines" name="Artículos en renta"
              parent="menu_rental_root" action="action_rental_active_lines"
              sequence="15"/>

    <menuitem id="menu_rental_products" name="Productos rentables"
              parent="menu_rental_root" action="action_rental_products"
              sequence="20"/>

    <menuitem id="menu_rental_reports" name="Reportes"
              parent="menu_rental_root" sequence="30"/>

    <menuitem id="menu_rental_active_orders" name="Rentas activas"
              parent="menu_rental_reports" action="action_rental_orders_active"
              sequence="10"/>

    <menuitem id="menu_rental_late_orders" name="Retrasos"
              parent="menu_rental_reports" action="action_rental_orders_late"
              sequence="20"/>

    <menuitem id="menu_rental_income" name="Ingresos (renta vs venta)"
              parent="menu_rental_reports" action="action_rental_income"
              sequence="30"/>

</odoo>
