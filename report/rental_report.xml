<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Datos de renta en el documento de venta (cotización y confirmación) -->
    <template id="report_saleorder_document_rental"
              inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@id='informations']" position="after">
            <div class="row mb-4" name="rental_information" t-if="doc.is_rental">
                <div class="col">
                    <strong>Fecha del evento</strong>
                    <div t-field="doc.fecha_evento" t-options='{"widget": "date"}'/>
                </div>
                <div class="col">
                    <strong>Entrega</strong>
                    <div t-field="doc.entrega_dt"/>
                </div>
                <div class="col">
                    <strong>Recolección</strong>
                    <div t-field="doc.recoleccion_dt"/>
                </div>
            </div>
            <div class="row mb-4" name="rental_address"
                 t-if="doc.is_rental and doc.domicilio_entrega">
                <div class="col">
                    <strong>Domicilio de entrega</strong>
                    <div t-field="doc.domicilio_entrega"/>
                </div>
            </div>
        </xpath>
        <!-- En renta no se imprime el domicilio del contacto: solo su nombre
             completo y su RFC. La dirección que importa es el domicilio de
             entrega capturado en la orden. -->
        <xpath expr="//t[@t-set='address']/div[@t-field='doc.partner_id']" position="replace">
            <div t-field="doc.partner_id" class="mb-0"
                 t-options='{"widget": "contact", "fields": ["name"] if doc.is_rental else ["address", "name"], "no_marker": True}'/>
        </xpath>
        <xpath expr="//t[@t-set='address']/p[@t-if='doc.partner_id.vat']" position="replace">
            <p t-if="doc.partner_id.vat" class="mb-0">
                <t t-if="doc.is_rental">RFC</t>
                <t t-elif="doc.company_id.account_fiscal_country_id.vat_label" t-out="doc.company_id.account_fiscal_country_id.vat_label"/>
                <t t-else="">Tax ID</t>: <span t-field="doc.partner_id.vat"/>
            </p>
        </xpath>
        <!-- Las direcciones de facturación y envío del contacto tampoco se
             imprimen en renta; solo aplica el domicilio de entrega. -->
        <xpath expr="//t[@t-set='information_block']" position="attributes">
            <attribute name="t-if">not doc.is_rental</attribute>
        </xpath>
        <!-- Firma manual del cliente, solo en el reporte "Confirmación de
             renta". El espaciador va en el flujo normal para que nunca se
             encime con la tabla y empuja la firma al pie de la última página. -->
        <xpath expr="//div[@class='page']" position="inside">
            <t t-if="is_rental_confirmation and report_type == 'pdf' and doc.is_rental and doc.state in ('sale', 'done')">
                <t t-set="rental_signature_layout"
                   t-value="doc._rental_signature_layout()"/>
                <div t-if="rental_signature_layout['spacer_mm'] > 0"
                     t-attf-style="{{ 'page-break-before: always; ' if rental_signature_layout['new_page'] else '' }}height: {{ '%.1f' % rental_signature_layout['spacer_mm'] }}mm;"/>
                <div name="rental_signature"
                     style="padding-top: 8mm; page-break-inside: avoid;">
                    <div class="row">
                        <div class="col-6 offset-3 text-center">
                            <div style="height: 60px;"></div>
                            <div style="border-top: 1px solid #000000; padding-top: 4px;">
                                Firma de conformidad del cliente
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title">
                <span t-if="doc.is_rental and doc.state not in ('draft', 'sent', 'cancel')">Confirmación de renta # </span>
                <span t-elif="is_proforma">Pro-Forma Invoice # </span>
                <span t-elif="doc.state in ['draft','sent']">Quotation # </span>
                <span t-else="">Order # </span>
                <span t-field="doc.name">SO0000</span>
            </t>
        </xpath>
    </template>

    <template id="report_rental_order">
        <t t-call="web.html_container">
            <t t-set="is_rental_confirmation" t-value="True"/>
            <t t-foreach="docs" t-as="doc">
                <t t-call="sale.report_saleorder_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

    <record id="action_report_rental_order" model="ir.actions.report">
        <field name="name">Confirmación de renta</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale_rental_fixed.report_rental_order</field>
        <field name="report_file">sale_rental_fixed.report_rental_order</field>
        <field name="print_report_name">'Renta - %s' % (object.name)</field>
    </record>

</odoo>
