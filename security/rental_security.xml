<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Odoo 19 agrupa los permisos por "privilege" en lugar de categoría. -->
    <record id="res_groups_privilege_rental" model="res.groups.privilege">
        <field name="name">Rentas</field>
        <field name="sequence">1</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_rental_user" model="res.groups">
        <field name="name">Usuario de rentas</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_rental"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Acceso al menú Rentas y a sus propias cotizaciones de renta.</field>
    </record>

    <record id="group_rental_manager" model="res.groups">
        <field name="name">Administrador de rentas</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_rental"/>
        <field name="implied_ids" eval="[(4, ref('group_rental_user')), (4, ref('sales_team.group_sale_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Ve todas las cotizaciones de renta y accede a la configuración de ventas y rentas.</field>
    </record>

</odoo>
